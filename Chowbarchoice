local function NewPage(name)
    local page = Create("ScrollingFrame", {
        Name = name,
        Size = UDim2.fromScale(1,1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        CanvasSize = UDim2.new(0,0,0,0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false
    }, Pages)

    local layout = Create("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, page)

    page.Visible = true
    return page
end

local function Toggle(parent, name, callback)
    local enabled = false

    local Row = Create("Frame", {
        Size = UDim2.new(1, -5, 0, 47),
        BackgroundColor3 = Color3.fromRGB(31, 40, 56),
        BorderSizePixel = 0
    }, parent)

    Create("UICorner", {
        CornerRadius = UDim.new(0, 8)
    }, Row)

    Create("TextLabel", {
        Position = UDim2.fromOffset(12,0),
        Size = UDim2.new(1,-85,1,0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = Color3.new(1,1,1),
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left
    }, Row)

    local Switch = Create("TextButton", {
        Position = UDim2.new(1,-67,0.5,-12),
        Size = UDim2.fromOffset(53,24),
        BackgroundColor3 = Color3.fromRGB(66,73,88),
        Text = "",
        AutoButtonColor = false
    }, Row)

    Create("UICorner", {
        CornerRadius = UDim.new(1,0)
    }, Switch)

    local Knob = Create("Frame", {
        Position = UDim2.fromOffset(3,3),
        Size = UDim2.fromOffset(18,18),
        BackgroundColor3 = Color3.new(1,1,1)
    }, Switch)

    Create("UICorner", {
        CornerRadius = UDim.new(1,0)
    }, Knob)

    Switch.MouseButton1Click:Connect(function()
        enabled = not enabled

        Switch.BackgroundColor3 = enabled
            and Color3.fromRGB(30,160,105)
            or Color3.fromRGB(66,73,88)

        Knob:TweenPosition(
            UDim2.fromOffset(enabled and 32 or 3,3),
            Enum.EasingDirection.Out,
            Enum.EasingStyle.Quad,
            0.12,
            true
        )

        if callback then
            callback(enabled)
        end
    end)

    return function()
        return enabled
    end
end

